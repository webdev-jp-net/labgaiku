---
import type { FlashMessageType } from '../lib/error-handler';

interface Props {
  message: string;
  type?: FlashMessageType;
  duration?: number;
}

const { message, type = 'info', duration = 4000 } = Astro.props as Props;
---

{message && (
  <div data-toast data-type={type}>
    <span>{message}</span>
    <button type="button" aria-label="閉じる">×</button>
  </div>
)}

<script is:inline define:vars={{ duration }}>
  const toast = document.querySelector('[data-toast]');
  if (toast) {
    const hide = () => {
      toast.style.display = 'none';
      window.setTimeout(() => {
        toast.remove();
      }, 250);
    };

    const button = toast.querySelector('button');
    button?.addEventListener('click', hide);

    window.setTimeout(hide, duration);

    const url = new URL(window.location.href);
    url.searchParams.delete('error');
    url.searchParams.delete('success');
    window.history.replaceState(null, '', url);
  }
</script>
