---
import type { AuthUser } from '../lib/auth';
import AuthButton from './AuthButton.astro';

export interface HeaderProps {
  user: AuthUser | null;
  currentPath?: string;
}

const { user, currentPath = '/' }: HeaderProps = Astro.props;
const isAuthenticated = Boolean(user);
---

<header>
  <div>
    <a href="/">Labが行く</a>
  </div>
  <nav aria-label="主要ナビゲーション">
    <a href="/articles">インタビュー記事</a>
  </nav>
  <div>
    {isAuthenticated ? (
      <>
        <div>
          {user?.name ?? 'ゲスト'}
          {user?.email && <span>({user.email})</span>}
        </div>
        <AuthButton variant="logout" />
      </>
    ) : (
      <a href="/login">ログイン</a>
    )}
  </div>
</header>
