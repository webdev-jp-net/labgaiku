---
import AuthButton from '../components/AuthButton.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { AuthUser } from '../lib/auth';
import { getAuthErrorMessage, getAuthSuccessMessage } from '../lib/error-handler';

const user = (Astro.locals.user as AuthUser | null) ?? null;
const flash = Astro.locals.flash;

const errorMessage =
  flash?.type === 'error' ? flash.message : getAuthErrorMessage(Astro.url.searchParams.get('error'));
const successMessage =
  flash?.type === 'success'
    ? flash.message
    : getAuthSuccessMessage(Astro.url.searchParams.get('success'));

const buildCallbackUrl = (rawCallback: string | null): string => {
  if (!rawCallback) {
    return '/articles?success=login';
  }

  try {
    const baseUrl = Astro.url;
    const target = new URL(rawCallback, baseUrl.origin);
    if (target.origin !== baseUrl.origin) {
      return '/articles?success=login';
    }

    if (!target.searchParams.has('success')) {
      target.searchParams.set('success', 'login');
    }

    return `${target.pathname}${target.search}`;
  } catch {
    return '/articles?success=login';
  }
};

const callbackUrl = buildCallbackUrl(Astro.url.searchParams.get('callbackUrl'));
---

<BaseLayout
  title="ログイン | TAMSAN Lab"
  user={user}
  currentPath="/login"
  flash={flash}
>
  <section>
    <div>
      <h1>TAMSAN Lab アカウントでログイン</h1>
      <p>
        Google または GitHub アカウントを使用して「Labが行く」のインタビュー記事にアクセスできます。
      </p>

      {errorMessage && <p>{errorMessage}</p>}
      {successMessage && <p>{successMessage}</p>}

      <div>
        <AuthButton variant="login" provider="google" callbackUrl={callbackUrl} />
        <AuthButton variant="login" provider="github" callbackUrl={callbackUrl} />
      </div>

      <p>
        ログインすることで、利用規約およびプライバシーポリシーに同意したものとみなされます。
      </p>
    </div>
  </section>
</BaseLayout>
