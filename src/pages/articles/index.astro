---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { AuthUser } from '../../lib/auth';

const user = (Astro.locals.user as AuthUser | null) ?? null;
const flash = Astro.locals.flash;

const entries = await getCollection('articles', ({ data }) => !data.draft);

const sortedEntries = entries.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

type ArticleSummary = CollectionEntry<'articles'> & {
  excerpt: string;
  formattedDate: string;
};

const summaries: ArticleSummary[] = sortedEntries.map((entry) => {
  const plainText = entry.body.replace(/\s+/g, ' ').trim();
  const excerpt = plainText.length > 120 ? `${plainText.slice(0, 120)}…` : plainText;

  return {
    ...entry,
    excerpt,
    formattedDate: entry.data.date.toLocaleDateString('ja-JP', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    }),
  };
});
---

<BaseLayout
  title="インタビュー記事一覧 | TAMSAN Lab"
  user={user}
  currentPath="/articles"
  flash={flash}
>
  <section>
    <header>
      <h1>インタビュー記事</h1>
      <p>
        TAMSAN Labの研究者やプロジェクトメンバーへのインタビュー記事をお届けします。最新の取り組みや学びをチェックしましょう。
      </p>
    </header>

    {summaries.length > 0 ? (
      <ul>
        {summaries.map((article) => (
          <li>
            <a href={`/articles/${article.slug}`}>
              <div>
                <span>{article.formattedDate}</span>
                <span>{article.data.author}</span>
              </div>
              <h2>{article.data.title}</h2>
              <p>{article.excerpt}</p>
              <div>
                {article.data.tags.map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p>公開中の記事はまだありません。準備が整い次第、順次公開していきます。</p>
    )}
  </section>
</BaseLayout>
