---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { AuthUser } from '../lib/auth';
import { getAuthErrorMessage } from '../lib/error-handler';
import styles from './_error.module.scss';

// 一時的に認証を無効化
const user = null;
const flash = null;

const errorCode = Astro.url.searchParams.get('error');
const message =
  flash?.type === 'error'
    ? flash.message
    : getAuthErrorMessage(errorCode) ?? '認証処理中に問題が発生しました。もう一度お試しください。';

const callbackUrl = Astro.url.searchParams.get('callbackUrl');
const loginLink = callbackUrl ? `/login?callbackUrl=${encodeURIComponent(callbackUrl)}` : '/login';
---

<BaseLayout
  title="エラー | TAMSAN Lab"
  user={user}
  currentPath="/error"
  flash={flash}
>
  <section class={styles.container}>
    <h1>認証エラーが発生しました</h1>
    <p class={styles.message}>{message}</p>
    {errorCode && <p class={styles.code}>エラーコード: {errorCode}</p>}
    <a href={loginLink} class={styles.link}>
      ログインページに戻る
    </a>
  </section>
</BaseLayout>
