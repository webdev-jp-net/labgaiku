---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { AuthUser } from '../lib/auth';
import { getAuthErrorMessage } from '../lib/error-handler';

const user = (Astro.locals.user as AuthUser | null) ?? null;
const flash = Astro.locals.flash;

const errorCode = Astro.url.searchParams.get('error');
const message =
  flash?.type === 'error'
    ? flash.message
    : getAuthErrorMessage(errorCode) ?? '認証処理中に問題が発生しました。もう一度お試しください。';

const callbackUrl = Astro.url.searchParams.get('callbackUrl');
const loginLink = callbackUrl ? `/login?callbackUrl=${encodeURIComponent(callbackUrl)}` : '/login';
---

<BaseLayout
  title="エラー | TAMSAN Lab"
  user={user}
  currentPath="/error"
  flash={flash}
>
  <section>
    <h1>認証エラーが発生しました</h1>
    <p>{message}</p>
    {errorCode && <p>エラーコード: {errorCode}</p>}
    <a href={loginLink}>ログインページに戻る</a>
  </section>
</BaseLayout>
